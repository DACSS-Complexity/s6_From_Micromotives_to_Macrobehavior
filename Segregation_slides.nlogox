<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[breed [citizens citizen]

patches-own [
  occupied_lot?  ; whether a citizen occupies this location
]

citizens-own [
  group           ; group membership: 0 or 1
  happy?          ; whether the local similarity threshold is met
  similar-nearby  ; number of same-group neighbours
  other-nearby    ; number of other-group neighbours
  total-nearby    ; total occupied neighbours
]


to setup
  clear-all  ; clear the previous simulation

  ; define the colors of the two citizen groups
  let color-map (list blue orange)

  ; initialize residential locations and create citizens
  ask patches [
    set pcolor white
    set occupied_lot? false

    ; populate each location according to the density parameter
    if random 100 < density [
      set occupied_lot? true

      sprout-citizens 1 [
        set group one-of [0 1]          ; assign a group randomly
        set color item group color-map  ; assign the corresponding color
      ]
    ]
  ]

  ; initialize citizen satisfaction and appearance
  ask citizens [
    evaluate  ; evaluate neighbourhood similarity and satisfaction
    update    ; set appearance according to satisfaction
  ]

  reset-ticks     ; initialize the simulation clock
end


to go
  ; stop the simulation when all citizens are satisfied
  if all? citizens [happy?] [stop]

  ; relocate dissatisfied citizens to available locations
  ask citizens with [not happy?] [
    move
  ]

  ; reevaluate satisfaction and update appearance after relocation
  ask citizens [
    evaluate  ; evaluate neighbourhood similarity and satisfaction
    update    ; set appearance according to satisfaction
  ]

  tick            ; advance the simulation clock
end


; A1: Citizen methods

to move
  ; identify all unoccupied residential locations
  let available-locations patches with [not occupied_lot?]

  ; relocate only if an available location exists
  if any? available-locations [
    let origin patch-here                     ; record the current location
    let destination one-of available-locations ; select a random vacant location

    ; release the current location
    ask origin [
      set occupied_lot? false
    ]

    move-to destination  ; relocate the citizen

    ; occupy the new location
    ask destination [
      set occupied_lot? true
    ]
  ]
end


to evaluate
  ; count same-group citizens on the eight surrounding patches
  set similar-nearby count (citizens-on neighbors)
    with [group = [group] of myself]

  ; count other-group citizens on the eight surrounding patches
  set other-nearby count (citizens-on neighbors)
    with [group != [group] of myself]

  ; calculate the total number of occupied neighbouring locations
  set total-nearby similar-nearby + other-nearby

  ; determine satisfaction based on the required similarity percentage
  set happy? similar-nearby >=
    (%-similar-wanted * total-nearby / 100)
end


to update
  ; represent satisfied citizens as squares and dissatisfied citizens as Xs
  ifelse happy? [
    set shape "square"
  ] [
    set shape "X"
  ]
end


; Observer: global indicators

to-report calculate-percent-similar
  ; count all same-group neighbour observations
  let similar-neighbors sum [similar-nearby] of citizens

  ; count all occupied-neighbour observations
  let total-neighbors sum [total-nearby] of citizens

  ; calculate the percentage of neighbours belonging to the same group
  if total-neighbors = 0 [report 0]
  report (similar-neighbors / total-neighbors) * 100
end


to-report calculate-percent-unhappy
  ; calculate the percentage of dissatisfied citizens
  if not any? citizens [report 0]
  report (count citizens with [not happy?]) / (count citizens) * 100
end


; Adapted from the NetLogo Segregation model.
; Copyright 1997 Uri Wilensky.
; See the original Info tab for full copyright and license.]]></code>
  <widgets>
    <view x="290" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-25" height="412" showTickCounter="true" patchSize="8.0" fontSize="10" wrappingAllowedY="true" width="412" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25"></view>
    <button x="10" y="72" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="setup">setup</button>
    <button x="200" y="72" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="85" display="go">go</button>
    <button x="100" y="72" height="40" disableUntilTicks="true" forever="false" kind="Observer" width="90" display="go once">go</button>
    <slider x="10" step="1" y="10" max="99" width="275" display="density" height="50" min="50" direction="Horizontal" default="50.0" variable="density" units="%"></slider>
    <slider x="10" step="1" y="124" max="100" width="275" display="%-similar-wanted" height="50" min="0" direction="Horizontal" default="75.0" variable="%-similar-wanted" units="%"></slider>
    <plot x="710" autoPlotX="true" yMax="100.0" autoPlotY="true" y="221" xMin="0.0" height="205" legend="false" xMax="10.0" yMin="0.0" width="250" display="Percent-unhappy">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot calculate-percent-unhappy</update>
      </pen>
    </plot>
    <plot x="710" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="%" y="11" xMin="0.0" height="205" legend="false" xMax="5.0" yMin="0.0" width="250" xAxis="time" display="Percent Similar">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="percent" color="-16777216" legend="true">
        <setup></setup>
        <update>plot calculate-percent-similar</update>
      </pen>
    </plot>
    <monitor x="965" precision="1" y="155" height="60" fontSize="11" width="100" display="% similar">calculate-percent-similar</monitor>
    <monitor x="965" precision="1" y="225" height="60" fontSize="11" width="100" display="% unhappy">calculate-percent-unhappy</monitor>
  </widgets>
  <info><![CDATA[# Schelling Segregation Model

## WHAT IS IT?

This course model was adapted by Prof. Jose Magallanes from Uri Wilensky’s NetLogo Segregation model (1997). 

The model explores how individual residential choices can produce collective segregation. Citizens belong to one of two groups and occupy locations on a residential grid. Each citizen requires a minimum percentage of its occupied neighbours to belong to its own group. Citizens whose neighbourhoods fall below that threshold are unhappy and relocate to a randomly selected vacant location.

A move changes the neighbourhoods experienced by others. Their responses can generate spatial clusters even when citizens accept substantial mixing. This illustrates Schelling’s point: **collective outcomes can be more segregated than individuals intended**.

The model demonstrates one possible mechanism. It does not provide a complete explanation of real residential segregation or establish individuals’ motives. It does not represent housing prices, income differences, discriminatory institutions, or access to jobs and services.

## HOW TO USE IT

Click **SETUP** to initialize the population. Each patch has a probability of receiving one citizen, controlled by `density`. Each new citizen independently receives group 0 or group 1 with equal probability. Population size and group proportions therefore vary across runs. No patch initially contains more than one citizen.

Blue and orange display group membership. Squares display satisfied citizens, and Xs display dissatisfied citizens. The `group` state determines similarity. Color displays group membership, while shape displays satisfaction.

Click **GO ONCE** to execute one cycle or **GO** to run continuously. When horizontal and vertical wrapping are enabled in NetLogo's world settings, the residential grid wraps across both boundaries.

`density` takes effect when SETUP runs. `%-similar-wanted` sets the minimum percentage of same-group neighbours required for satisfaction. At a value of 30, a citizen needs at least 30% of its occupied neighbours to belong to its own group. Run SETUP after changing the threshold when comparing fresh scenarios.

## HOW IT WORKS

### Initialization (`setup`)

- Clear the previous simulation.
- Define the colors of the two citizen groups.
- Initialize residential locations and create citizens.
- Populate each location according to the `density` parameter.
- Assign each citizen a group randomly (0 or 1) and assign the corresponding color.
- Initialize citizen satisfaction and appearance.
- Initialize the simulation clock.

### Simulation (`go`)

- Stop the simulation when all citizens are satisfied.
- Relocate dissatisfied citizens to available locations.
- After all dissatisfied citizens have had a turn to move, reevaluate satisfaction and update appearance for all citizens.
- Advance the simulation clock.

### Citizen methods (A1)

**`move()` — Relocation**

- Identify all unoccupied residential locations.
- Relocate only if an available location exists.
- Record the current location and select a random vacant location.
- Release the current location by setting its `occupied_lot?` state to `false`.
- Relocate the citizen.
- Occupy the new location by setting its `occupied_lot?` state to `true`.

**`evaluate()` — Neighbourhood evaluation**

- Count same-group citizens on the eight surrounding patches.
- Count other-group citizens on the eight surrounding patches.
- Calculate the total number of occupied neighbouring locations.
- Determine satisfaction using `similar-nearby >= (%-similar-wanted * total-nearby / 100)`.

**`update()` — Appearance**

- Represent satisfied citizens as squares and dissatisfied citizens as Xs.

### Observer: Global indicators

**`calculate-percent-similar` — Reporter**

- Count all same-group neighbour observations.
- Count all occupied-neighbour observations.
- Calculate the percentage of neighbours belonging to the same group.
- Report zero when there are no occupied-neighbour observations.

**`calculate-percent-unhappy` — Reporter**

- Calculate the percentage of dissatisfied citizens.
- Report zero when there are no citizens.

The observer coordinates simulation execution through `setup` and `go`, while observer-level reporters calculate macro-level measurements. Citizen procedures implement individual behavior.

## MEASURES AND VISUALIZATION

**% SIMILAR** reports the percentage of pooled neighbour observations belonging to the same group. The reporter `calculate-percent-similar` sums `similar-nearby` across citizens and divides by the sum of `total-nearby`. Citizens with more neighbours contribute more weight. This is an indicator of local similarity rather than a simple average of each citizen's percentage or a comprehensive measure of segregation.

**% UNHAPPY** reports the percentage of dissatisfied citizens, calculated by `calculate-percent-unhappy`.

These are the model’s two reporter indicators. Monitors and plot pens for percent similar use `calculate-percent-similar`; those for percent unhappy use `calculate-percent-unhappy`.

The two groups initially mix randomly, so initial similarity will generally be near 50%, with variation between runs. Color identifies group membership. Shape makes satisfaction visible while students inspect the spatial pattern.

## THINGS TO NOTICE

Do the clusters become more distinct as citizens move? Does a move make other citizens satisfied or dissatisfied?

Does everyone becoming satisfied imply that the population remains mixed? Compare the map, % SIMILAR, and % UNHAPPY before answering.

The number of dissatisfied citizens need not fall at every cycle. Movement can create new dissatisfied citizens. Outcomes and time to stop vary across parameter settings and random initial populations.



## THINGS TO TRY

Explore the model interactively using SETUP, GO ONCE, and GO. Compare the residential map with % SIMILAR and % UNHAPPY.

### Change the similarity threshold

Keep `density` fixed. Try lower and higher values of `%-similar-wanted`, running SETUP before each fresh scenario.

- Can citizens become happy while the city remains strongly clustered by group?
- Does a modest minimum similarity requirement produce a similarly modest final same-group neighbour share?
- How does the threshold affect the number of cycles needed for everyone to become happy? Do some runs continue without reaching that state?

### Change population density

Keep `%-similar-wanted` fixed and compare lower and higher values of `density`. Click SETUP after changing density so the new value takes effect.

- How does the availability of vacant locations affect relocation and the emerging pattern?
- How do density and the number of occupied neighbours affect happiness?
- What happens if no vacant locations are available while some citizens remain unhappy?



## NETLOGO FEATURES AND MODEL LIMITS

`sprout-citizens` creates citizens on patches. In SETUP, each selected patch creates exactly one citizen.

`ask` selects the agents that act. Called procedures retain the executing agent’s context.

`move` identifies vacant patches using `patches with [not occupied_lot?]` and selects a random destination using `one-of`. The procedure uses `any?` to verify that at least one vacant location exists. It checks vacancy, not whether the destination will satisfy the citizen’s similarity threshold. NetLogo executes the selected dissatisfied citizens in random order, updating occupancy after each move.

`patch-here` identifies the citizen’s current location. `move-to` relocates the citizen directly to the selected destination patch.

The `occupied_lot?` state is updated explicitly: the origin becomes vacant and the destination becomes occupied. This maintains the one-citizen-per-patch constraint.

The `evaluate` method uses `citizens-on neighbors` to identify citizens on the eight surrounding patches. The `with` condition compares their group membership with that of the evaluating citizen, using `myself`.

Citizens with no occupied neighbours are considered satisfied because their required number of same-group neighbours is zero.

The `update` method changes the citizen’s shape according to its satisfaction state. It does not change group membership or location.

`calculate-percent-similar` and `calculate-percent-unhappy` are observer-level reporters that calculate macro-level indicators from the citizens’ states. They can be called directly by monitors and plots.

Both reporters guard against division by zero. `calculate-percent-similar` reports zero when there are no occupied-neighbour observations, while `calculate-percent-unhappy` reports zero when there are no citizens.

When no vacant patches exist, `move` leaves dissatisfied citizens in place. The simulation may therefore continue without achieving an all-satisfied state.

The `go` procedure stops when all citizens are happy. This code contains no fixed tick limit. If happiness is never achieved, the simulation can continue until the user stops GO.

## CREDITS AND REFERENCES

This teaching adaptation defines an explicit Citizen breed, separates group membership from color, introduces patch occupancy states, and replaces the original movement search with direct relocation to randomly selected vacant patches.

The adaptation separates neighbourhood evaluation, relocation, and appearance updates into Citizen procedures, while macro-level indicators are calculated through observer-level reporters.

The reverse-engineering scaffold and interactive activities are teaching adaptations, rather than claims made by the original authors.

Schelling, T. C. (1969). Models of Segregation. *The American Economic Review, 59*(2), 488–493.

Schelling, T. (1978). *Micromotives and Macrobehavior*. New York: Norton.

The 1969 reading provides the theoretical discussion. Its line example differs from this NetLogo grid implementation.

See also: Rauch, J. (2002). Seeing Around Corners. *The Atlantic Monthly*, April 2002, 289(4), 35–48. https://www.theatlantic.com/magazine/archive/2002/04/seeing-around-corners/302471/

## HOW TO CITE

For the original model:

- Wilensky, U. (1997). *NetLogo Segregation model*. http://ccl.northwestern.edu/netlogo/models/Segregation. Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.

For the software:

- Wilensky, U. (1999). *NetLogo*. http://ccl.northwestern.edu/netlogo/. Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.

When describing this version, also identify it as a teaching adaptation and explain the changes used in your analysis.

## AUTHORSHIP AND ACKNOWLEDGMENTS

Prof. Jose Magallanes prepared this teaching model for an agent-based modeling course, adapting code from Uri Wilensky’s NetLogo Segregation model (1997).

This version introduces an explicit Citizen breed, separates group membership from color, tracks residential occupancy through patch states, and implements direct relocation to randomly selected vacant locations.

It also separates citizen relocation, neighbourhood evaluation, and appearance updates into distinct methods, calculates macro-level indicators through observer-level reporters, and includes a reverse-engineering teaching approach and interactive exploration activities.

The model draws on Thomas Schelling’s work on how individual residential preferences can generate collective segregation.

This course version is distinct from the model distributed in the NetLogo Models Library. The original code attribution and license remain below.

## COPYRIGHT AND LICENSE

Copyright 1997 Uri Wilensky.

