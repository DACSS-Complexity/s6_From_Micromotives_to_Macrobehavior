<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  percent-similar  ; percentage of pooled neighbour counts in the same group
  percent-unhappy  ; percentage of turtles that are unhappy
]

turtles-own [
  group           ; group membership: 0 or 1
  happy?          ; whether the local similarity threshold is met
  similar-nearby  ; number of same-group neighbours
  other-nearby    ; number of other-group neighbours
  total-nearby    ; total occupied neighbours
]

to setup
  clear-all

  ; initialize locations and create individuals
  let color-map (list blue orange)

  ask patches [
    set pcolor white
    if random 100 < density [
      sprout 1 [
        set group one-of [0 1]
        set color item group color-map
      ]
    ]
  ]

  update-turtles
  update-globals
  update-appearance
  reset-ticks
end

to go
  if all? turtles [ happy? ] [ stop ]

  move-unhappy-turtles
  update-turtles
  update-globals
  update-appearance
  tick
end

to move-unhappy-turtles
  ask turtles with [ not happy? ] [
    find-new-spot
  ]
end

to find-new-spot
  rt random-float 360
  fd random-float 10

  ifelse any? other turtles-here [
    find-new-spot
  ] [
    move-to patch-here
  ]
end

to update-turtles
  ask turtles [
    ; count neighbours on the eight surrounding patches
    set similar-nearby count (turtles-on neighbors)
      with [ group = [ group ] of myself ]

    set other-nearby count (turtles-on neighbors)
      with [ group != [ group ] of myself ]

    set total-nearby similar-nearby + other-nearby
    set happy? similar-nearby >=
      (%-similar-wanted * total-nearby / 100)
  ]
end

to update-globals
  let similar-neighbors sum [ similar-nearby ] of turtles
  let total-neighbors sum [ total-nearby ] of turtles

  set percent-similar
    (similar-neighbors / total-neighbors) * 100

  set percent-unhappy
    (count turtles with [ not happy? ]) / (count turtles) * 100
end

to update-appearance
  ask turtles [
    ifelse happy? [
      set shape "square"
    ] [
      set shape "X"
    ]
  ]
end

; Adapted from the NetLogo Segregation model.
; Copyright 1997 Uri Wilensky.
; See the original Info tab for full copyright and license.]]></code>
  <widgets>
    <view x="290" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-25" height="412" showTickCounter="true" patchSize="8.0" fontSize="10" wrappingAllowedY="true" width="412" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25"></view>
    <button x="10" y="72" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="setup">setup</button>
