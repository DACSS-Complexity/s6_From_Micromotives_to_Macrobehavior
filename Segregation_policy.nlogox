<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[breed [citizens citizen]

patches-own [
  occupied_lot?    ; whether this residential location is occupied
]

citizens-own [
  group             ; group membership: 0 or 1
  requirement-met?  ; compliance with the imposed minimum
]


to setup
  clear-all
  ask patches [
    set pcolor white
    set occupied_lot? false

    ; Each location has an 85% probability of being occupied.
    if random 100 < 85 [
      set occupied_lot? true

      sprout-citizens 1 [
        let color-map (list blue orange)
        set group one-of [0 1]
        set color item group color-map
      ]
    ]
  ]

  ; Calculate initial compliance and display it.
  ask citizens [
    evaluate
    update
  ]

  reset-ticks
end


to go
  if all? citizens [requirement-met?] [stop]

  ; Citizens below the minimum attempt relocation in random order.
  ask citizens with [not requirement-met?] [
    move
  ]

  ; Reevaluate everyone after the relocation stage.
  ask citizens [
    evaluate
    update
  ]

  tick
end


; A1: Citizen methods

to move
  let available-locations patches with [not occupied_lot?]

  if any? available-locations [
    let origin patch-here
    let destination one-of available-locations

    ask origin [
      set occupied_lot? false
    ]

    ; The destination is chosen for vacancy, not similarity.
    move-to destination

    ask destination [
      set occupied_lot? true
    ]
  ]
end


to-report neighborhood-counts
  ; Count citizens on surrounding patches, excluding this patch.
  let nearby citizens-on neighbors
  let my-group group

  let same-group-count count nearby with [group = my-group]
  let total-count count nearby

  ; Return two values; list positions start at zero.
  report (list same-group-count total-count)
end


to evaluate
  let counts neighborhood-counts
  let similar-nearby item 0 counts
  let total-nearby item 1 counts

  ; Compliance is not personal satisfaction.
  ; With no occupied neighbors, the requirement is met.
  set requirement-met? similar-nearby >=
    (%-similar-required * total-nearby / 100)
end


to update
  ; Color shows group; shape shows compliance.
  ifelse requirement-met? [
    set shape "square"
  ] [
    set shape "X"
  ]
end


; Observer: collective indicators

to-report calculate-percent-similar
  let counts-by-citizen [neighborhood-counts] of citizens

  ; Extract and sum each type of count.
  let similar-neighbors sum
    (map [counts -> item 0 counts] counts-by-citizen)

  let total-neighbors sum
    (map [counts -> item 1 counts] counts-by-citizen)

  if total-neighbors = 0 [report 0]

  ; Pool counts before calculating the percentage.
  report 100 * similar-neighbors / total-neighbors
end


to-report calculate-percent-required-to-relocate
  if not any? citizens [report 0]

  report 100 *
    (count citizens with [not requirement-met?]) /
    (count citizens)
end


; Observer: save final locations
; Enter export-final-positions in BehaviorSpace's Post run commands.

to export-final-positions
  ; Link the position file to its run and endpoint tick.
  let base-name (word
    "positions-run-" behaviorspace-run-number
    "-tick-" ticks)

  let filename (word base-name ".csv")
  let suffix 1

  ; Add a suffix if necessary to avoid overwriting an existing file.
  while [file-exists? filename] [
    set filename (word base-name "-" suffix ".csv")
    set suffix suffix + 1
  ]

  ; Relative filenames use NetLogo's current working directory.
  file-open filename
  file-print "run,minimum,ticks,citizen,group,x,y"

  ; Write citizens in identifier order, one row per citizen.
  foreach sort citizens [ person ->
    ; xcor is the horizontal coordinate; ycor is the vertical one.
    ; Together they locate this citizen on the residential grid.
    ; Group identifies which population occupies that location.
    file-print (word
      behaviorspace-run-number ","
      %-similar-required ","
      ticks ","
      [who] of person ","
      [group] of person ","
      [xcor] of person ","
      [ycor] of person)
  ]

  ; Close the file after all rows have been written.
  file-close
end


; Adapted from the NetLogo Segregation model.
; Copyright 1997 Uri Wilensky.
; See the original Info tab for full copyright and license.]]></code>
  <widgets>
    <view x="290" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-25" height="412" showTickCounter="true" patchSize="8.0" fontSize="10" wrappingAllowedY="false" width="412" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25"></view>
    <button x="10" y="72" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="setup">setup</button>
    <button x="200" y="72" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="85" display="go">go</button>
    <button x="100" y="72" height="40" disableUntilTicks="true" forever="false" kind="Observer" width="90" display="go once">go</button>
