<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[breed [citizens citizen]

patches-own [
  occupied?  ; whether a citizen occupies this location
]

citizens-own [
  group           ; group membership: 0 or 1
  happy?          ; whether the local similarity threshold is met
  similar-nearby  ; number of same-group neighbours
  other-nearby    ; number of other-group neighbours
  total-nearby    ; total occupied neighbours
]


to setup
  clear-all  ; clear the previous simulation

  ; define the colors of the two citizen groups
  let color-map (list blue orange)

  ; initialize residential locations and create citizens
  ask patches [
    set pcolor white
    set occupied? false

    ; populate each location according to the density parameter
    if random 100 < density [
      set occupied? true

      sprout-citizens 1 [
        set group one-of [0 1]          ; assign a group randomly
        set color item group color-map  ; assign the corresponding color
      ]
    ]
  ]

  ; initialize citizen satisfaction and appearance
  ask citizens [
    evaluate  ; evaluate neighbourhood similarity and satisfaction
    update    ; set appearance according to satisfaction
  ]

  reset-ticks     ; initialize the simulation clock
end


to go
  ; stop the simulation when all citizens are satisfied
  if all? citizens [happy?] [stop]

  ; relocate dissatisfied citizens to available locations
  ask citizens with [not happy?] [
    move
  ]

  ; reevaluate satisfaction and update appearance after relocation
  ask citizens [
    evaluate  ; evaluate neighbourhood similarity and satisfaction
    update    ; set appearance according to satisfaction
  ]

  tick            ; advance the simulation clock
end


; A1: Citizen methods

to move
  ; identify all unoccupied residential locations
  let available-locations patches with [not occupied?]

  ; relocate only if an available location exists
  if any? available-locations [
    let origin patch-here                     ; record the current location
    let destination one-of available-locations ; select a random vacant location

    ; release the current location
    ask origin [
      set occupied? false
    ]

    move-to destination  ; relocate the citizen

    ; occupy the new location
    ask destination [
      set occupied? true
    ]
  ]
end


to evaluate
  ; count same-group citizens on the eight surrounding patches
  set similar-nearby count (citizens-on neighbors)
    with [group = [group] of myself]

  ; count other-group citizens on the eight surrounding patches
  set other-nearby count (citizens-on neighbors)
    with [group != [group] of myself]

  ; calculate the total number of occupied neighbouring locations
  set total-nearby similar-nearby + other-nearby

  ; determine satisfaction based on the required similarity percentage
  set happy? similar-nearby >=
    (%-similar-wanted * total-nearby / 100)
end


to update
  ; represent satisfied citizens as squares and dissatisfied citizens as Xs
  ifelse happy? [
    set shape "square"
  ] [
    set shape "X"
  ]
end


; Observer: global indicators

to-report calculate-percent-similar
  ; count all same-group neighbour observations
  let similar-neighbors sum [similar-nearby] of citizens

  ; count all occupied-neighbour observations
  let total-neighbors sum [total-nearby] of citizens

  ; calculate the percentage of neighbours belonging to the same group
  if total-neighbors = 0 [report 0]
  report (similar-neighbors / total-neighbors) * 100
end


to-report calculate-percent-unhappy
  ; calculate the percentage of dissatisfied citizens
  if not any? citizens [report 0]
  report (count citizens with [not happy?]) / (count citizens) * 100
end


; Adapted from the NetLogo Segregation model.
; Copyright 1997 Uri Wilensky.
; See the original Info tab for full copyright and license.]]></code>
